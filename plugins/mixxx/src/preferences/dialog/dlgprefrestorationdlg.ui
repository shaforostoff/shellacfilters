  <property name="windowTitle">
   <string>Restoration</string>
  </property>
  <layout class="QVBoxLayout" name="verticalLayout">
   <item>
    <widget class="QLabel" name="introLabel">
     <property name="text">
      <string>Repair shellac and vinyl transfers as they are decoded, before anything else in Mixxx sees them. Because the restoration reads the track rather than the passing buffer, it adds no latency to a deck and hum is found in the first seconds rather than the first minute.

Waveforms, beat detection and key detection are not affected: they read the original file.</string>
     </property>
     <property name="wordWrap">
      <bool>true</bool>
     </property>
    </widget>
   </item>
   <item>
    <widget class="QLabel" name="reloadLabel">
     <property name="text">
      <string>Changes take effect the next time a track is loaded into a deck.</string>
     </property>
     <property name="wordWrap">
      <bool>true</bool>
     </property>
    </widget>
   </item>
   <item>
    <widget class="QGroupBox" name="declickGroup">
     <property name="title">
      <string>Declick</string>
     </property>
     <property name="toolTip">
      <string>Finds the impulses that blow up an autoregressive model's prediction error and rebuilds what the waveform should have been.</string>
     </property>
     <property name="checkable">
      <bool>true</bool>
     </property>
     <property name="checked">
      <bool>false</bool>
     </property>
     <layout class="QFormLayout" name="declickForm">
      <item row="0" column="0">
       <widget class="QLabel" name="declickSensitivityLabel">
        <property name="text">
         <string>Sensitivity:</string>
        </property>
       </widget>
      </item>
      <item row="0" column="1">
       <widget class="QDoubleSpinBox" name="declickSensitivity">
        <property name="toolTip">
         <string>Trigger, in robust sigmas: 0 is 6.0 and catches only unmistakable clicks, 1 is 2.5 and starts costing music. 0.60 is 3.9 sigma.</string>
        </property>
        <property name="decimals">
         <number>2</number>
        </property>
        <property name="maximum">
         <double>1.000000000000000</double>
        </property>
        <property name="singleStep">
         <double>0.050000000000000</double>
        </property>
       </widget>
      </item>
      <item row="1" column="0">
       <widget class="QLabel" name="declickExtentLabel">
        <property name="text">
         <string>Extent:</string>
        </property>
       </widget>
      </item>
      <item row="1" column="1">
       <widget class="QDoubleSpinBox" name="declickExtent">
        <property name="toolTip">
         <string>How far a detection spreads outwards into its own tail.</string>
        </property>
        <property name="decimals">
         <number>2</number>
        </property>
        <property name="maximum">
         <double>1.000000000000000</double>
        </property>
        <property name="singleStep">
         <double>0.050000000000000</double>
        </property>
       </widget>
      </item>
      <item row="2" column="0">
       <widget class="QLabel" name="declickMaxRepairLabel">
        <property name="text">
