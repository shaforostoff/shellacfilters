    <widget class="QGroupBox" name="dehumGroup">
     <property name="title">
      <string>Dehum</string>
     </property>
     <property name="toolTip">
      <string>Finds continuous narrowband tones - mains hum, its harmonics, and the off-frequency drones on speed-corrected disc transfers - without being told the frequency, and cancels them with a tracking notch.</string>
     </property>
     <property name="checkable">
      <bool>true</bool>
     </property>
     <property name="checked">
      <bool>false</bool>
     </property>
