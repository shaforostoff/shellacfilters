// foo_dsp_paraeq - resources

#include <windows.h>
#include <commctrl.h>
#include "resource.h"
#include "version.h"

/////////////////////////////////////////////////////////////////////////////
// Configuration dialog
//
// Almost empty on purpose. IDC_EDITOR_PLACEHOLDER is a hidden control whose
// rectangle says where the owner-drawn editor goes; config_dialog.cpp reads it,
// creates the editor over it and hides it. Keeping the rectangle here rather
// than in code means the layout stays visible in one place.

IDD_PARAEQ DIALOGEX 0, 0, 324, 236
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Parametric EQ"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    CONTROL         "",IDC_EDITOR_PLACEHOLDER,"STATIC",SS_BLACKFRAME | NOT WS_VISIBLE,
                    7,7,310,178

    LTEXT           "Drag a handle for frequency and gain; wheel for gain, shift+wheel for Q; right-click for shelf/bell, the low-cut slope and a list of Q widths. Keyboard: left/right the band's frequency, up/down its gain, ctrl+up/down its Q, ctrl+left/right to change band.",
                    IDC_HINT,7,190,310,25

    PUSHBUTTON      "&Defaults",IDC_DEFAULTS,7,217,54,14
    PUSHBUTTON      "Ca&librate...",IDC_CALIBRATE,65,217,60,14
    DEFPUSHBUTTON   "OK",IDOK,209,217,54,14
    PUSHBUTTON      "Cancel",IDCANCEL,267,217,50,14
END

/////////////////////////////////////////////////////////////////////////////
// Room calibration for the Reverb cut band
//
// IDC_CAL_PLOT is owner-drawn: the measured response, its trend and the
// response with the suggested cut applied.

IDD_PARAEQ_CALIBRATE DIALOGEX 0, 0, 330, 268
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Calibrate Reverb cut"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Play music with Parametric EQ in the DSP chain. Choose the microphone, press Start, and walk slowly through the middle of the room for a minute or two, holding the microphone at ear height.",
                    IDC_STATIC,7,7,316,26

    LTEXT           "&Microphone:",IDC_STATIC,7,38,44,8
    COMBOBOX        IDC_CAL_DEVICE,54,36,212,200,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    DEFPUSHBUTTON   "&Start",IDC_CAL_START,270,35,53,14

    LTEXT           "",IDC_CAL_STATUS,7,55,316,42
    CONTROL         "",IDC_CAL_PLOT,"Static",SS_OWNERDRAW,7,99,316,122
    LTEXT           "",IDC_CAL_RESULT,7,225,316,18

    COMBOBOX        IDC_CAL_CHOICE,7,248,150,200,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP | WS_DISABLED
    PUSHBUTTON      "&Apply to Reverb cut",IDC_CAL_APPLY,161,247,84,14,WS_DISABLED
    PUSHBUTTON      "Close",IDCANCEL,273,247,50,14
END

/////////////////////////////////////////////////////////////////////////////
// Version

VS_VERSION_INFO VERSIONINFO
 FILEVERSION FOO_DSP_PARAEQ_VERSION_COMMA
 PRODUCTVERSION FOO_DSP_PARAEQ_VERSION_COMMA
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS__WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Parametric EQ DSP for foobar2000"
            VALUE "FileVersion",     FOO_DSP_PARAEQ_VERSION_STRING
            VALUE "InternalName",    "foo_dsp_paraeq"
            VALUE "OriginalFilename","foo_dsp_paraeq.dll"
            VALUE "ProductName",     "foo_dsp_paraeq"
            VALUE "ProductVersion",  FOO_DSP_PARAEQ_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
