// foo_dsp_declick - resources

#include <windows.h>
#include <commctrl.h>
#include "resource.h"
#include "version.h"

/////////////////////////////////////////////////////////////////////////////
// Configuration dialog

IDD_DECLICK DIALOGEX 0, 0, 292, 92
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Declick"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Sensitivity",IDC_LABEL_SENSITIVITY,7,12,52,8,SS_NOTIFY
    CONTROL         "",IDC_SLIDER_SENSITIVITY,"msctls_trackbar32",TBS_HORZ | TBS_NOTICKS | WS_TABSTOP,62,9,178,15
    RTEXT           "0.900",IDC_VALUE_SENSITIVITY,244,12,41,8,SS_NOTIFY

    LTEXT           "Model order",IDC_LABEL_ORDER,7,34,52,8,SS_NOTIFY
    CONTROL         "",IDC_SLIDER_ORDER,"msctls_trackbar32",TBS_HORZ | TBS_AUTOTICKS | WS_TABSTOP,62,31,178,15
    RTEXT           "128",IDC_VALUE_ORDER,244,34,41,8,SS_NOTIFY

    AUTOCHECKBOX    "E&xtra cautious: repair the clicks, leave everything else",IDC_CAUTIOUS,62,52,223,10
    PUSHBUTTON      "&Defaults",IDC_DEFAULTS,7,70,54,15
    AUTOCHECKBOX    "&Bypass",IDC_BYPASS,74,72,44,10
    AUTOCHECKBOX    "D&elta",IDC_DELTA,124,72,44,10
    DEFPUSHBUTTON   "OK",IDOK,177,70,54,15
    PUSHBUTTON      "Cancel",IDCANCEL,235,70,50,15
END

/////////////////////////////////////////////////////////////////////////////
// Version

VS_VERSION_INFO VERSIONINFO
 FILEVERSION FOO_DSP_DECLICK_VERSION_COMMA
 PRODUCTVERSION FOO_DSP_DECLICK_VERSION_COMMA
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS__WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Declick DSP for foobar2000 (AR interpolation)"
            VALUE "FileVersion",     FOO_DSP_DECLICK_VERSION_STRING
            VALUE "InternalName",    "foo_dsp_declick"
            VALUE "OriginalFilename","foo_dsp_declick.dll"
            VALUE "ProductName",     "foo_dsp_declick"
            VALUE "ProductVersion",  FOO_DSP_DECLICK_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
